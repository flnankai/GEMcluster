\name{gem_select_k_gap}
\alias{gem_select_k_gap}
\alias{gap_select_k}
\title{Select K by GAP statistic with GEM fits}
\usage{
gem_select_k_gap(X, K_grid = 2:5, B = 20L, control = NULL,
  soft_dispersion = TRUE, seed = NULL, rule = c("1se", "max"),
  verbose = TRUE)
}
\arguments{
\item{X}{n by p data matrix.}
\item{K_grid}{Candidate K values.}
\item{B}{Number of column-permutation reference samples.}
\item{control}{Named list passed to \code{gem_fit}.}
\item{soft_dispersion}{If TRUE, use posterior-weighted GEM dispersion.}
\item{seed}{Optional random seed.}
\item{rule}{Either \code{"1se"} or \code{"max"}; controls \code{best_K}.}
\item{verbose}{If TRUE, print progress.}
}
\description{
Fits GEM over candidate K values and applies the GAP statistic with
column-wise permutation reference samples. The command returns both the
maximum-GAP and one-standard-error selected values.
}
\details{
For every candidate \code{K}, GEM is fitted to the observed data. Reference
datasets are generated by independently permuting each feature column, and GEM
is refitted to each reference dataset. The default reported \code{best_K} uses
the lower-complexity one-standard-error rule.
}
\value{
An object of class \code{"gem_gap"}, represented as a list containing
\code{summary}, \code{best_K}, \code{best_K_gap_1se}, \code{best_K_gap_max},
the selected fitted objects, and the reference log-dispersion matrix.
}
\examples{
if (requireNamespace("mvtnorm", quietly = TRUE) &&
    requireNamespace("huge", quietly = TRUE)) {
  set.seed(2)
  Mu <- dense_block_means(K = 3, p = 5, signal = 0.9)
  Sigma <- make_ar_cov(p = 5, rho = 0.4)
  dat <- simulate_elliptical_mixture(
    n = 30, Mu = Mu, Sigma = Sigma, family = "gaussian", seed = 2
  )

  gap <- gem_select_k_gap(
    dat$X,
    K_grid = 2:3,
    B = 1,
    control = list(
      max_outer = 1,
      init_n_boot = 1,
      init_nstart = 2,
      init_max_iter = 5,
      outer_nstart = 1
    ),
    verbose = FALSE
  )
  gap$best_K
}
}
